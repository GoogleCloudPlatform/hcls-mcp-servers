# Copy this file to terraform.tfvars and fill in your values.
# Do NOT commit terraform.tfvars to git (it's in .gitignore).
#
# NOTE: In the CI/CD pipeline, terraform.tfvars is auto-generated by
# Cloud Build. This file is only needed for local terraform runs.

project_id = "your-project-id"
region     = "us-central1"
repo_name  = "healthcare-mcp"
image_tag  = "latest"
